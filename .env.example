# Application Configuration
SPRING_PROFILES_ACTIVE=prod

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/micromarket_db
DATABASE_USERNAME=admin
DATABASE_PASSWORD=admin

# JWT Keys (leave commented for dev to auto-generate)
# Use dot notation here (.env is loaded as a properties file)
# In Docker/OS env vars, use JWT_PUBLIC_KEY / JWT_PRIVATE_KEY instead
# Generate keys with: ./scripts/generate-jwt-keys.sh ./secrets/jwt
#jwt.public.key=file:./secrets/jwt/app.pub
#jwt.private.key=file:./secrets/jwt/app.key

